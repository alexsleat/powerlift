# Copy this file to .env and fill in your values.
# docker-compose reads .env automatically.

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Host port the app is exposed on (default: 8080)
PORT=8080

# Set to true if you have HTTPS configured (strongly recommended for production)
COOKIE_SECURE=false
